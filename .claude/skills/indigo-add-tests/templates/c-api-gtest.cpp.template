#include <gtest/gtest.h>

#include <base_cpp/exception.h>
#include <indigo.h>

#include "common.h"

using namespace indigo;

// IndigoApiTest allocates a session per test and installs an error handler that throws
// indigo::Exception, so a failing call throws instead of returning -1.
class IndigoApi{Suite}Test : public IndigoApiTest
{
};

TEST_F(IndigoApi{Suite}Test, {function}_{Scenario}_{Expected})
{
    const int molecule = indigoLoadMoleculeFromString("{smiles}");
    EXPECT_EQ({expected}, {indigoFunction}(molecule));
    indigoFree(molecule);
}

TEST_F(IndigoApi{Suite}Test, {function}_{InvalidInput}_Throws)
{
    EXPECT_THROW({call that must fail}, Exception);
}

// A try/catch written around a C API call in the test body does not catch on Windows: the exception
// escapes to gtest. The message is checked the C way, with the throwing handler removed.
TEST_F(IndigoApi{Suite}Test, {function}_{InvalidInput}_ReportsMessage)
{
    indigoSetErrorHandler(nullptr, nullptr);
    EXPECT_EQ(-1, {call that must fail});
    EXPECT_STREQ("{exact message}", indigoGetLastError());
}
