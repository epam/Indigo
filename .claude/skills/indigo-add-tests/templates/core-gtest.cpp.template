#include <gtest/gtest.h>

#include <base_cpp/exception.h>
#include <molecule/molecule.h>

#include "common.h"

using namespace indigo;

class {Suite}Test : public IndigoCoreTest
{
};

TEST_F({Suite}Test, {Subject}_{Scenario}_{Expected})
{
    Molecule molecule;
    loadMolecule("{smiles}", molecule);

    EXPECT_EQ({expected}, {expression on molecule});
}

// The message is a public contract: assert the text, not only that something was thrown.
TEST_F({Suite}Test, {Subject}_{InvalidInput}_ThrowsWithMessage)
{
    Molecule molecule;
    try
    {
        {call that must fail};
        FAIL() << "expected an exception";
    }
    catch (Exception& e)
    {
        EXPECT_STREQ("{exact message}", e.message());
    }
}
